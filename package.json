{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "buddy",
  "type": "module",
  "version": "0.70.23",
  "title": "Stacks Buddy",
  "description": "Search and run every Buddy command in a local Stacks project.",
  "author": "chrisbreuer",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/raycast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/raycast.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/raycast/issues"
  },
  "keywords": [
    "raycast",
    "typescript"
  ],
  "categories": [
    "Productivity"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./*": {
      "import": "./dist/*"
    }
  },
  "module": "./dist/index.js",
  "icon": "stacks-logo.png",
  "owner": "stacks",
  "preferences": [
    {
      "name": "projectDirectory",
      "type": "directory",
      "required": true,
      "title": "Stacks Project",
      "description": "Select the Stacks project whose Buddy commands should be loaded."
    },
    {
      "name": "terminalApplication",
      "type": "textfield",
      "required": true,
      "default": "Terminal",
      "title": "Terminal Application",
      "description": "The macOS terminal application used to run Buddy commands."
    }
  ],
  "commands": [
    {
      "name": "index",
      "title": "Stacks Buddy",
      "subtitle": "Stacks Buddy Commands",
      "description": "Search and run every command registered by a local Stacks project",
      "mode": "view"
    }
  ],
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "dev": "bunx ray develop",
    "build": "bun --bun build.ts",
    "fresh": "bunx rimraf node_modules/ bun.lock && bun i",
    "prepublishOnly": "bun --bun run build",
    "test": "bun test",
    "lint": "bunx --bun pickier . --ignore-path .gitignore",
    "lint:fix": "bunx --bun pickier . --ignore-path .gitignore --fix",
    "changelog": "bunx logsmith --verbose",
    "changelog:generate": "bunx logsmith --output CHANGELOG.md",
    "release": "bunx --bun bumpx prompt --recursive",
    "postinstall": "bunx git-hooks",
    "dev:docs": "bun --bun vitepress dev docs",
    "build:docs": "bun --bun vitepress build docs",
    "preview:docs": "bun --bun vitepress preview docs",
    "typecheck": "bun --bun tsc --noEmit",
    "publish": "bunx --bun @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^1.104.25",
    "@raycast/utils": "^1.19.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@eslint-react/eslint-plugin": "^1.53.1",
    "@stacksjs/bumpx": "^0.2.17",
    "@stacksjs/docs": "^0.74.24",
    "@stacksjs/gitlint": "^0.1.8",
    "@stacksjs/logsmith": "^0.2.11",
    "@types/bun": "^1.4.1",
    "buddy-bot": "^0.10.5",
    "bun-git-hooks": "^0.3.3",
    "bun-plugin-dtsx": "^0.21.17",
    "typescript": "^5.9.3"
  },
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun pickier --fix"
      }
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  }
}
