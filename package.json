{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "buddy",
  "type": "module",
  "version": "0.0.1",
  "title": "Stacks Buddy",
  "description": "The Stacks Raycast extension.",
  "author": "Stacks.js",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/raycast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/raycast.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/raycast/issues"
  },
  "keywords": [
    "raycast",
    "typescript"
  ],
  "categories": [
    "Productivity"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "import": "./dist/*"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "icon": "stacks-logo.ico",
  "owner": "stacks",
  "commands": [
    {
      "name": "index",
      "title": "Stacks Buddy",
      "subtitle": "Stacks Buddy Commands",
      "description": "Search and view Stacks Buddy commands",
      "mode": "view"
    }
  ],
  "files": ["README.md", "dist"],
  "scripts": {
    "dev": "ray develop",
    "build": "bun --bun build.ts",
    "lint": "bunx --bun eslint . && ray lint",
    "lint:fix": "bunx --bun eslint . --fix && ray lint --fix",
    "fresh": "bunx rimraf node_modules/ bun.lock && bun i",
    "changelog": "bunx changelogen --output CHANGELOG.md",
    "prepublishOnly": "bun --bun run build",
    "release": "bun run changelog && bunx bumpp package.json --all",
    "test": "bun test",
    "dev:docs": "bun --bun vitepress dev docs",
    "build:docs": "bun --bun vitepress build docs",
    "preview:docs": "bun --bun vitepress preview docs",
    "typecheck": "bun --bun tsc --noEmit",
    "publish": "bunx --bun @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^1.94.4",
    "@raycast/utils": "^1.19.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.11.0",
    "@stacksjs/docs": "^0.70.23",
    "@types/bun": "^1.2.8",
    "bumpp": "^10.1.0",
    "bun-plugin-dtsx": "^0.21.9",
    "changelogen": "^0.6.1",
    "lint-staged": "^15.5.0",
    "simple-git-hooks": "^2.12.1",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "unconfig": "0.3.10"
  },
  "lint-staged": {
    "*.{js,ts}": "bunx --bun eslint . --fix"
  }
}
