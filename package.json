{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "buddy",
  "type": "module",
  "version": "0.70.23",
  "title": "Stacks Buddy",
  "description": "The Stacks Raycast extension.",
  "author": "Stacks.js",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/raycast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/raycast.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/raycast/issues"
  },
  "keywords": [
    "raycast",
    "typescript"
  ],
  "categories": [
    "Productivity"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "import": "./dist/*"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "icon": "stacks-logo.ico",
  "owner": "stacks",
  "commands": [
    {
      "name": "index",
      "title": "Stacks Buddy",
      "subtitle": "Stacks Buddy Commands",
      "description": "Search and view Stacks Buddy commands",
      "mode": "view"
    }
  ],
  "files": ["README.md", "dist"],
  "scripts": {
    "dev": "  npx ray develop",
    "build": "bun --bun build.ts",
    "fresh": "bunx rimraf node_modules/ bun.lock && bun i",
    "prepublishOnly": "bun --bun run build",
    "test": "bun test",
    "lint": "bunx --bun eslint .",
    "lint:fix": "bunx --bun eslint . --fix",
    "changelog": "bunx logsmith --verbose",
    "changelog:generate": "bunx logsmith --output CHANGELOG.md",
    "release": "bun run changelog:generate && bunx bumpx prompt --recursive",
    "postinstall": "bunx git-hooks",
    "dev:docs": "bun --bun vitepress dev docs",
    "build:docs": "bun --bun vitepress build docs",
    "preview:docs": "bun --bun vitepress preview docs",
    "typecheck": "bun --bun tsc --noEmit",
    "publish": "bunx --bun @raycast/api@latest publish"
  },
  "dependencies": {
    "@raycast/api": "^1.94.4",
    "@raycast/utils": "^2.2.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.11.0",
    "@eslint-react/eslint-plugin": "^2.5.8",
    "@stacksjs/bumpx": "^0.1.17",
    "@stacksjs/docs": "^0.70.23",
    "@stacksjs/gitlint": "^0.1.5",
    "@stacksjs/logsmith": "^0.1.8",
    "@types/bun": "^1.2.8",
    "buddy-bot": "^0.8.9",
    "bun-git-hooks": "^0.2.19",
    "bun-plugin-dtsx": "^0.21.9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "unconfig": "0.3.10"
  },
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun eslint --fix"
      }
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  }
}
